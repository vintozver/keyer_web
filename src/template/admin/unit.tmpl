{% extends "skeleton" %}

{% macro hidden(action, unit_id) -%}
<input type="hidden" name="csrf_token" value="{{ csrf_token|e }}" />
<input type="hidden" name="action" value="{{ action|e }}" />
<input type="hidden" name="unit_id" value="{{ unit_id|string|e }}" />
{%- endmacro %}

{% macro unit_fields(unit) -%}
<p><label>Display name <input name="name" value="{{ unit.name|e if unit else '' }}" maxlength="128" required="required" /></label>
<label>Remote host <input name="host" value="{{ unit.host|e if unit else '' }}" required="required" /></label>
<label>Port <input name="port" type="number" value="{{ unit.port if unit else 80 }}" min="1" max="65535" required="required" /></label>
<button type="submit">Save unit</button></p>
{%- endmacro %}

{% block body_content %}
<h1>Admin: Keyer units</h1>
<p><a href="/">Back to access system</a></p>
<p>Private signing keys stay on the units. Add only PEM public keys or certificates.
Removing a key immediately prevents authentication with that key; removing a unit
also removes all its signing keys.</p>
{% for unit in units %}
<section>
<h2>{{ unit.name|e }}</h2>
<p>Unit id: <code>{{ unit.id|string|e }}</code></p>
<form action="/admin/unit" method="post">
{{ hidden('save', unit.id) }}
{{ unit_fields(unit) }}
</form>
<h3>Signing keys</h3>
<ul>
{% for key in unit.keyset %}
<li><form action="/admin/unit" method="post">
{{ hidden('delete_key', unit.id) }}
<input type="hidden" name="key_id" value="{{ key.id|e }}" />
<code>{{ key.id|e }}</code> ({{ 'certificate' if key.crt else 'public key' }})
<button type="submit" onclick="return window.confirm('Remove this signing key?');">Remove key</button>
</form></li>
{% else %}
<li>No signing keys. This unit cannot authenticate callbacks yet.</li>
{% endfor %}
</ul>
<form action="/admin/unit" method="post">
{{ hidden('add_key', unit.id) }}
<p><label>New key id <input name="key_id" required="required" /></label></p>
<p><label>PEM public key or certificate<br />
<textarea name="material" rows="8" cols="72" required="required"></textarea></label></p>
<p><button type="submit">Add signing key</button></p>
</form>
<form action="/admin/unit" method="post">
{{ hidden('delete', unit.id) }}
<p><button type="submit" onclick="return window.confirm('Delete this unit and all its signing keys?');">Delete unit</button></p>
</form>
</section>
{% else %}
<p>No units configured.</p>
{% endfor %}
<h2>Add unit</h2>
<form action="/admin/unit" method="post">
{{ hidden('save', '') }}
{{ unit_fields(none) }}
</form>
{% endblock %}
